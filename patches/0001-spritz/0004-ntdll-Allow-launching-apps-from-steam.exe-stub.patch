From 7383f5213dcc7ea87111a72403855ad6f26c2590 Mon Sep 17 00:00:00 2001
From: NelloKudo <marshnelloosu@gmail.com>
Date: Mon, 25 Aug 2025 23:25:25 +0200
Subject: [PATCH 04/10] ntdll: Allow launching apps from steam.exe stub.

Some games need to be launched from Proton's stub steam.exe to allow
being launched on Linux and related systems: this allows doing so without
any Proton script, but straight up from Wine.
---
 dlls/ntdll/unix/env.c          | 43 +++++++++++++++++++++++++++++-----
 dlls/ntdll/unix/loader.c       | 28 ++++++++++++++++++++++
 dlls/ntdll/unix/unix_private.h |  1 +
 3 files changed, 66 insertions(+), 6 deletions(-)

diff --git a/dlls/ntdll/unix/env.c b/dlls/ntdll/unix/env.c
index bd888b9928b..42d10e30593 100644
--- a/dlls/ntdll/unix/env.c
+++ b/dlls/ntdll/unix/env.c
@@ -1869,6 +1869,24 @@ static void init_peb( RTL_USER_PROCESS_PARAMETERS *params, BOOL debugged )
 }
 
 
+/* HACK: Check for conditions to use the Steam stub */
+static BOOL use_steam_stub(void)
+{
+    static volatile char cache = -1;
+    if (cache == -1)
+    {
+        const char *env = getenv("WINE_ENABLE_STEAM_STUB");
+
+        if (env && atoi(env))
+            cache = TRUE;
+        else
+            cache = FALSE;
+    }
+
+    return cache;
+}
+
+
 /*************************************************************************
  *		build_initial_params
  *
@@ -1885,6 +1903,7 @@ static RTL_USER_PROCESS_PARAMETERS *build_initial_params(void)
     WCHAR *curdir = get_initial_directory();
     UNICODE_STRING nt_name;
     NTSTATUS status;
+    BOOL launch_with_steam = use_steam_stub();
     struct thread_data *data = get_thread_data();
 
     data->filesys_redir = TRUE;
@@ -1931,18 +1950,30 @@ static RTL_USER_PROCESS_PARAMETERS *build_initial_params(void)
         }
     }
 
-    if (status)  /* try launching it through start.exe */
+    /* check if we should launch from the Steam stub */
+    if (launch_with_steam)
     {
-        static const char *args[] = { "start.exe", "/exec" };
+        static const char *args[] = { "steam.exe" };
         free( nt_name.Buffer );
         if (main_module) NtUnmapViewOfSection( GetCurrentProcess(), main_module );
-        load_start_exe( &nt_name );
-        prepend_argv( args, 2 );
+        load_steam_exe( &nt_name );
+        prepend_argv( args, 1 );
     }
     else
     {
-        rebuild_argv();
-        data->filesys_redir = FALSE;
+        if (status)  /* try launching it through start.exe */
+        {
+            static const char *args[] = { "start.exe", "/exec" };
+            free( nt_name.Buffer );
+            if (main_module) NtUnmapViewOfSection( GetCurrentProcess(), main_module );
+            load_start_exe( &nt_name );
+            prepend_argv( args, 2 );
+        }
+        else
+        {
+            rebuild_argv();
+            data->filesys_redir = FALSE;
+        }
     }
 
     virtual_alloc_first_teb();
diff --git a/dlls/ntdll/unix/loader.c b/dlls/ntdll/unix/loader.c
index ebfb6af5387..f3b71c153d3 100644
--- a/dlls/ntdll/unix/loader.c
+++ b/dlls/ntdll/unix/loader.c
@@ -1497,6 +1497,34 @@ NTSTATUS load_start_exe( UNICODE_STRING *nt_name )
     return status;
 }
 
+
+/***********************************************************************
+ *           load_steam_exe
+ *
+ * Load steam.exe as main image.
+ * Adapted from load_start_exe.
+ */
+NTSTATUS load_steam_exe( UNICODE_STRING *nt_name )
+{
+    static const WCHAR startW[] = {'s','t','e','a','m','.','e','x','e',0};
+    unsigned int status;
+    SIZE_T size;
+    WCHAR *image = malloc( sizeof("\\??\\C:\\windows\\system32\\steam.exe") * sizeof(WCHAR) );
+
+    wcscpy( image, get_machine_wow64_dir( current_machine ));
+    wcscat( image, startW );
+    init_unicode_string( nt_name, image );
+    status = find_builtin_dll( nt_name, NULL, &main_module, &size,
+                               &main_image_info, 0, 0, current_machine, 0, FALSE, 0 );
+    if (!NT_SUCCESS(status))
+    {
+        MESSAGE( "wine: failed to load steam.exe: %x\n", status );
+        NtTerminateProcess( GetCurrentProcess(), status );
+    }
+    MESSAGE( "wine: launching from steam.exe stub!\n" );
+    return status;
+}
+
 static ULONG_PTR find_ordinal_export( HMODULE module, const IMAGE_EXPORT_DIRECTORY *exports, DWORD ordinal )
 {
     const DWORD *functions = (const DWORD *)((BYTE *)module + exports->AddressOfFunctions);
diff --git a/dlls/ntdll/unix/unix_private.h b/dlls/ntdll/unix/unix_private.h
index 9b6401ee37d..916a65f55dd 100644
--- a/dlls/ntdll/unix/unix_private.h
+++ b/dlls/ntdll/unix/unix_private.h
@@ -248,6 +248,7 @@ extern NTSTATUS load_unixlib_by_name( const UNICODE_STRING *nt_name, void **hand
 extern BOOL is_system_dir_path( const UNICODE_STRING *path, WORD *machine );
 extern NTSTATUS load_main_exe( UNICODE_STRING *nt_name, USHORT load_machine );
 extern NTSTATUS load_start_exe( UNICODE_STRING *nt_name );
+extern NTSTATUS load_steam_exe( UNICODE_STRING *nt_name );
 extern ULONG_PTR redirect_arm64ec_rva( void *module, ULONG_PTR rva, const IMAGE_ARM64EC_METADATA *metadata );
 extern void start_server( BOOL debug );
 

