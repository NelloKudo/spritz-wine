From 7f8d1cf0bc04710f596e7bcf66aed38e25aae753 Mon Sep 17 00:00:00 2001
From: NelloKudo <marshnelloosu@gmail.com>
Date: Thu, 18 Sep 2025 11:50:52 +0200
Subject: [PATCH] HACK: ntdll: Set WINE_ENABLE_STEAM_STUB for some games.

Based on Proton's hacks_init() function.
---
 dlls/ntdll/unix/loader.c | 14 ++++++++++++++
 1 file changed, 14 insertions(+)

diff --git a/dlls/ntdll/unix/loader.c b/dlls/ntdll/unix/loader.c
index c1321ce679d..0204179f0fe 100644
--- a/dlls/ntdll/unix/loader.c
+++ b/dlls/ntdll/unix/loader.c
@@ -1848,6 +1848,19 @@ static ULONG_PTR get_image_address(void)
     return 0;
 }
 
+static void hacks_init(void)
+{
+    if (main_argc > 1 &&
+        (strstr(main_argv[1], "GenshinImpact.exe") ||
+         strstr(main_argv[1], "YuanShen.exe") ||
+         strstr(main_argv[1], "fpsunlock.exe") ||
+         strstr(main_argv[1], "BH3.exe") || 
+         strstr(main_argv[1], "ZenlessZoneZero.exe")))
+    {
+        setenv("WINE_ENABLE_STEAM_STUB", "1", 0);
+    }
+}
+
 /***********************************************************************
  *           start_main_thread
  */
@@ -1857,6 +1870,7 @@ static void start_main_thread(void)
 
     dbg_init();
     startup_info_size = server_init_process();
+    hacks_init();
     virtual_map_user_shared_data();
     init_cpu_info();
     init_files();
-- 
2.55.0

