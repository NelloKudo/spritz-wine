-    bytes_reader_init(&bytes_reader, buffer, read_size);
-    chunk_hash = calloc(1, sizeof(*chunk_hash));
-    murmur3_128(&bytes_reader, bytes_reader_read, HASH_SEED, chunk_hash);
-    *chunk_hashes = g_list_append(*chunk_hashes, chunk_hash);
-
-    bytes_reader_init(&bytes_reader, buffer, read_size);
