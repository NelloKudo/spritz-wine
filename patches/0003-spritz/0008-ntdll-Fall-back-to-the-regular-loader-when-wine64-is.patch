From 92ce703369267afe2b9447c0fc3e023395d511c7 Mon Sep 17 00:00:00 2001
From: NelloKudo <marshnelloosu@gmail.com>
Date: Mon, 23 Nov 2026 09:27:16 +0100
Subject: [PATCH 37/37] ntdll: Fall back to the regular loader when wine64 is
 missing in the preloader.

---
 dlls/ntdll/unix/loader.c | 15 +++++++++++++--
 1 file changed, 13 insertions(+), 2 deletions(-)

diff --git a/dlls/ntdll/unix/loader.c b/dlls/ntdll/unix/loader.c
index de250f3a634..e204da66395 100644
--- a/dlls/ntdll/unix/loader.c
+++ b/dlls/ntdll/unix/loader.c
@@ -487,12 +487,23 @@ static void preloader_exec( char **argv, WORD machine )
 #ifdef HAVE_WINE_PRELOADER
 #if !defined(__arm__) && !defined(__aarch64__)
     const char *p;
+    char *wine64 = NULL;
 
     if (machine == IMAGE_FILE_MACHINE_AMD64
         && ((p = remove_tail( argv[1], "x86_64-unix/wine" )) || (p = remove_tail( argv[1], "i386-unix/wine64" ))))
     {
-        asprintf( &argv[0], "%si386-unix/wine64-preloader", p );
-        asprintf( &argv[1], "%si386-unix/wine64", p );
+        asprintf( &wine64, "%si386-unix/wine64", p );
+        if (access( wine64, X_OK ))
+        {
+            free( wine64 );
+            wine64 = NULL;
+        }
+    }
+
+    if (wine64)
+    {
+        asprintf( &argv[0], "%s-preloader", wine64 );
+        argv[1] = wine64;
     }
     else
 #endif
