From fe09655d58b1cda553a4afeaa40c4ea117ee2d02 Mon Sep 17 00:00:00 2001
From: Etaash Mathamsetty
 <45927311+Etaash-mathamsetty@users.noreply.github.com>
Date: Sun, 14 Jun 2026 00:52:06 -0400
Subject: [PATCH] winewayland: Add a third roundtrip during init.

---
 dlls/winewayland.drv/wayland.c | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/dlls/winewayland.drv/wayland.c b/dlls/winewayland.drv/wayland.c
index 56297dedc81..38d72c1f22e 100644
--- a/dlls/winewayland.drv/wayland.c
+++ b/dlls/winewayland.drv/wayland.c
@@ -385,6 +385,9 @@ BOOL wayland_process_init(void)
     wl_display_roundtrip_queue(process_wayland.wl_display, process_wayland.wl_event_queue);
     wl_display_roundtrip_queue(process_wayland.wl_display, process_wayland.wl_event_queue);
 
+    /* A third roundtrip to help avoid race conditions for zxdg output and color management extensions. */
+    wl_display_roundtrip_queue(process_wayland.wl_display, process_wayland.wl_event_queue);
+
     /* Check for required protocol globals. */
     if (!process_wayland.wl_compositor)
     {
