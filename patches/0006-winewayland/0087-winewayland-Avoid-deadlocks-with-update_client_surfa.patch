From 8db2b87455fe8404aea7cbda9ec0d0c4924b1431 Mon Sep 17 00:00:00 2001
From: Etaash Mathamsetty
 <45927311+Etaash-mathamsetty@users.noreply.github.com>
Date: Sat, 15 Aug 2026 23:06:03 -0400
Subject: [PATCH] winewayland: Avoid deadlocks with update_client_surfaces.

---
 dlls/winewayland.drv/wayland_surface.c | 3 ---
 1 file changed, 3 deletions(-)

diff --git a/dlls/winewayland.drv/wayland_surface.c b/dlls/winewayland.drv/wayland_surface.c
index 39508a8c6af..b41d51a9d92 100644
--- a/dlls/winewayland.drv/wayland_surface.c
+++ b/dlls/winewayland.drv/wayland_surface.c
@@ -333,9 +333,6 @@ void wp_fractional_scale_handle_scale(void* user_data,
 
     surface->window.scale = scale;
 
-    /* reattach client surfaces as their rects have changed */
-    update_client_surfaces(hwnd);
-
     wayland_win_data_release(data);
 
     NtUserExposeWindowSurface(hwnd, 0, NULL);
-- 
