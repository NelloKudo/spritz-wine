From 4f71ee8f5cfc3950139362a5851b14b421b7b3b1 Mon Sep 17 00:00:00 2001
From: Etaash Mathamsetty
 <45927311+Etaash-mathamsetty@users.noreply.github.com>
Date: Wed, 19 Aug 2026 00:06:52 -0400
Subject: [PATCH] winewayland: Use offscreen rendering for shaped windows.

---
 dlls/winewayland.drv/wayland_surface.c | 13 ++++++++-----
 dlls/winewayland.drv/waylanddrv.h      |  2 +-
 dlls/winewayland.drv/window.c          |  2 +-
 3 files changed, 10 insertions(+), 7 deletions(-)

diff --git a/dlls/winewayland.drv/wayland_surface.c b/dlls/winewayland.drv/wayland_surface.c
index 1d34fc2117e..c777beb1df7 100644
--- a/dlls/winewayland.drv/wayland_surface.c
+++ b/dlls/winewayland.drv/wayland_surface.c
@@ -1544,12 +1544,17 @@ static LONG force_use_offscreen(void)
 static void wayland_client_surface_update_offscreen(struct wayland_client_surface *surface)
 {
     HWND hwnd = surface->client.hwnd, toplevel = NtUserGetAncestor(hwnd, GA_ROOT);
+    struct wayland_win_data *data;
     LONG offscreen = force_use_offscreen();
-    DWORD pid, flags;
+    DWORD flags;
     BYTE alpha;
 
-    if (NtUserGetWindowThread(toplevel, &pid) && pid != GetCurrentProcessId())
-        offscreen = TRUE;
+    if (!(data = wayland_win_data_get(toplevel))) offscreen = TRUE;
+    else
+    {
+        if (data->shaped) offscreen = TRUE;
+        wayland_win_data_release(data);
+    }
 
     if (!offscreen && NtUserGetLayeredWindowAttributes(toplevel, NULL, &alpha, &flags) &&
         (flags & LWA_ALPHA) && alpha != 0xff)
@@ -1558,8 +1563,6 @@ static void wayland_client_surface_update_offscreen(struct wayland_client_surfac
     if (!offscreen && NtUserGetWindowRelative(hwnd, GW_CHILD))
         offscreen = needs_client_window_clipping(hwnd);
 
-    /* TODO: Check for window shape */
-
     InterlockedExchange(&surface->client.offscreen, offscreen);
 }
 
diff --git a/dlls/winewayland.drv/waylanddrv.h b/dlls/winewayland.drv/waylanddrv.h
index 882b6464b19..2327b310c66 100644
--- a/dlls/winewayland.drv/waylanddrv.h
+++ b/dlls/winewayland.drv/waylanddrv.h
@@ -372,7 +372,6 @@ struct wayland_client_surface
     RECT rect;
     HANDLE throttle;
     RECT viewport_rect;
-    BOOL other_process;
     struct wl_callback *wl_callback;
     struct wl_surface *wl_surface;
     struct wl_subsurface *wl_subsurface;
@@ -532,6 +531,7 @@ struct wayland_win_data
     BOOL resizeable;
     BOOL managed;
     BOOL layered_attribs_set;
+    BOOL shaped;
     int ime_ref;
 };
 
diff --git a/dlls/winewayland.drv/window.c b/dlls/winewayland.drv/window.c
index 069ad912be0..c2b100dd799 100644
--- a/dlls/winewayland.drv/window.c
+++ b/dlls/winewayland.drv/window.c
@@ -472,7 +472,7 @@ BOOL WAYLAND_WindowPosChanging(HWND hwnd, UINT swp_flags, BOOL shaped, const str
     TRACE("hwnd %p, swp_flags %04x, shaped %u, rects %s\n", hwnd, swp_flags, shaped, debugstr_window_rects(rects));
 
     if (!data && !(data = wayland_win_data_create(hwnd, rects))) return FALSE;
-
+    data->shaped = shaped;
     wayland_win_data_release(data);
 
     return TRUE;
-- 
2.56.0

